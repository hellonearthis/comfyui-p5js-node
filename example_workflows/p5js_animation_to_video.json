        "function setup() {\n  createCanvas(512, 512);\n}\n\nfunction draw() {\n  background(16, 18, 28);\n  noFill();\n  strokeWeight(3);\n  const t = frameCount * 0.12;\n  for (let i = 0; i < 10; i++) {\n    stroke(80 + i * 16, 180, 255 - i * 12);\n    beginShape();\n    for (let x = 0; x <= width; x += 16) {\n      const y = height / 2 + sin(x * 0.02 + t + i * 0.4) * (60 + i * 8);\n      vertex(x, y);\n    }\n    endShape();\n  }\n}",
